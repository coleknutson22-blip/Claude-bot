# Copy to .env and fill in your own values. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# NOTHING in this project ever reads an exchange API key. Market data comes
# from public endpoints only, and there is no order-placement code path to use
# a key with even if one were supplied. Do not add one.

# --- Telegram -------------------------------------------------------------
# From @BotFather. Looks like 1234567890:AAH...
TELEGRAM_BOT_TOKEN=

# The chat to notify. A personal chat is a positive integer; a group or
# channel is negative, e.g. -1001234567890. Message @userinfobot to find it.
TELEGRAM_CHAT_ID=

# Set to 0/false/no to run with notifications switched off entirely.
# TELEGRAM_ENABLED=true
